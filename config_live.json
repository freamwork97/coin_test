  "strategy": {
    "name": "trendrider",
    "params": {
      "ema_fast": 9,
      "ema_slow": 16,
      "rsi_period": 16,
      "rsi_pullback_low": 30,
      "rsi_pullback_high": 65,
      "rsi_bounce_level": 35,
      "adx_threshold": 18,
