        "neutral": {
          "max_positions": 4,
          "position_size_pct": 0.10,
          "min_confidence": 6
        },
        "bear": {
          "max_positions": 2,
          "position_size_pct": 0.05,
          "min_confidence": 7
        }
      },
      "cache_ttl_seconds": 300
