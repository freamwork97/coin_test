      "enabled": true,
      "btc_ma_fast": 50,
      "btc_ma_slow": 200,
      "btc_interval": "60",
      "regimes": {
        "bull": {
          "max_positions": 7,
          "position_size_pct": 0.15,
          "min_confidence": 5
